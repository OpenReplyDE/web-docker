{
  "compilerOptions": {
    "allowJs": true,
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "declaration": true,
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src/core",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src/core/**/*"],
  "exclude": ["src/core/main.ts", "src/core/ServiceExtension.ts"]
}
